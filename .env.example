# Recommended primary provider for collection and required by smoke-test.
# Collection commands can fall back to RSS/Atom, SearXNG, and direct HTTP when this is absent.
FIRECRAWL_API_KEY=fc-your-key-here

# Optional runtime defaults.
TECHTEMBER_DB=data/techtember.db
# Optional date used for {start_date} in configured search terms.
# TECHTEMBER_START_DATE=2026-09-01

# Optional no-credit fallbacks. Fallbacks are enabled by default.
# TECHTEMBER_FALLBACK_ENABLED=true
# TECHTEMBER_FALLBACK_TIMEOUT_SECONDS=20
# Set true to test or intentionally use fallbacks even when a Firecrawl key exists.
# TECHTEMBER_FORCE_FALLBACK=true
# Optional URL for a self-hosted SearXNG instance, e.g. http://localhost:8080
# TECHTEMBER_SEARXNG_URL=http://localhost:8080
